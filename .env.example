# Database Configuration
# Primary: MySQL (College Requirement)
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=traffic_analytics
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/traffic_analytics

# Seamless Fallback (Automatic if MySQL is temporarily unreachable)
SQLITE_FALLBACK_URL=sqlite:///./traffic_analytics.db
USE_SQLITE_FALLBACK=True

# Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=traffic-events
KAFKA_CONSUMER_GROUP=traffic-analytics-group
# KAFKA_MODE options: "kafka", "simulator", "auto" (auto attempts Kafka, falls back to in-memory streaming queue if Kafka is down)
KAFKA_MODE=auto

# Server & Dashboard Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
LIVE_SERVER_URL=http://127.0.0.1:5500
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# Event Stream Frequency
EVENT_INTERVAL_SECONDS=2.0
TRAFFIC_SLIDING_WINDOW_EVENTS=20

